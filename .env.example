# ===================================================================
# Project A — API Gateway Environment Configuration Template
# ===================================================================

# Server Port
SERVER_PORT=8080

# Spring Profiles (default, dev, docker, prod)
SPRING_PROFILES_ACTIVE=docker

# Downstream Microservice Target URLs
IDENTITY_ACCESS_URL=http://identity-access-service:8081
RESIDENT_MANAGEMENT_URL=http://resident-management-service:8082
PROPERTY_UNIT_URL=http://property-unit-service:8083
LEASE_OCCUPANCY_URL=http://lease-occupancy-service:8084
BILLING_PAYMENT_URL=http://billing-payment-service:8085
UTILITY_CHARGE_URL=http://utility-charge-service:8086
OPERATIONS_URL=http://operations-service:8087
COMMUNITY_URL=http://community-service:8088

# RSA Key Security Settings (PEM formatted string or file path reference)
# Identity Access Public Key (used to verify incoming user/service tokens)
PROJECTA_SECURITY_IDENTITY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAuX...

# Gateway Private Key (used by Gateway to re-sign downstream tokens)
PROJECTA_SECURITY_GATEWAY_PRIVATE_KEY=MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC5...

# Gateway Public Key (used by downstream microservices to verify Gateway re-signed tokens)
PROJECTA_SECURITY_GATEWAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAvY...

# Logging Levels
LOGGING_LEVEL_COM_PROJECTA=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_CLOUD_GATEWAY=INFO
