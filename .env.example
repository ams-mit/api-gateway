# ===================================================================
# Project A — API Gateway Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env or key files.
# ===================================================================

# Server Port (host side)
SERVER_PORT=8080

# Optional Spring profile (e.g. dev enables DEBUG logging)
SPRING_PROFILES_ACTIVE=

# Browser origins allowed by CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Downstream Microservice Target URLs
IDENTITY_ACCESS_SERVICE_URL=http://identity-access-service:3001
RESIDENT_MANAGEMENT_SERVICE_URL=http://resident-management-service:3002
PROPERTY_UNIT_SERVICE_URL=http://property-unit-service:3003
LEASE_OCCUPANCY_SERVICE_URL=http://lease-occupancy-service:3004
BILLING_PAYMENT_SERVICE_URL=http://billing-payment-service:3005
UTILITY_CHARGE_SERVICE_URL=http://utility-charge-service:3006
OPERATIONS_SERVICE_URL=http://operations-service:3007
COMMUNITY_SERVICE_URL=http://community-service:3008

# -------------------------------------------------------------------
# RSA keys. Each value is EITHER a location (file:/app/keys/x.pem,
# classpath:keys/x.pem) OR the PEM text itself (literal \n allowed).
# Private key must be PKCS#8 ("BEGIN PRIVATE KEY").
# -------------------------------------------------------------------

# Identity Access public key — verifies incoming User JWTs (required)
IDENTITY_JWT_PUBLIC_KEY=file:/app/keys/identity_public.pem

# Gateway private key — signs Gateway JWTs sent to backends (required)
GATEWAY_JWT_PRIVATE_KEY=file:/app/keys/gateway_private.pem

# Lifetime of Gateway-issued JWTs
GATEWAY_JWT_EXPIRES_IN=5m

# Registered service public keys — verify incoming Service JWTs.
# Leave blank to reject Service JWTs from that service.
IDENTITY_ACCESS_SERVICE_PUBLIC_KEY=
RESIDENT_MANAGEMENT_SERVICE_PUBLIC_KEY=file:/app/keys/resident_management_public.pem
