# ===================================================================
# Project A — API Gateway environment configuration
# Copy to .env and fill in real values. Never commit .env or key files.
# Every value without a default in application.yml is REQUIRED: the
# Gateway refuses to start if one is missing or invalid.
# ===================================================================

# Gateway port (host side for docker compose)
SERVER_PORT=8080

# Backend service base URIs (Docker service DNS names in the integrated compose)
IDENTITY_SERVICE_URI=http://identity-access-service:8080
RESIDENT_SERVICE_URI=http://resident-management-service:8080
PROPERTY_SERVICE_URI=http://property-unit-service:8080
LEASE_SERVICE_URI=http://lease-occupancy-service:8080
BILLING_SERVICE_URI=http://billing-payment-service:8080
UTILITY_SERVICE_URI=http://utility-charge-service:8080
OPERATIONS_SERVICE_URI=http://operations-service:8080
COMMUNITY_SERVICE_URI=http://community-service:8080

# Browser origins allowed by CORS: exact origins (comma-separated) or * for any origin
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000

# Downstream timeouts
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_READ_TIMEOUT_MS=5000

# -------------------------------------------------------------------
# RSA keys. Each value is EITHER a location (file:/app/keys/x.pem)
# OR the PEM text itself (literal \n allowed). Private key: PKCS#8.
# -------------------------------------------------------------------
# Identity Access public key — verifies User JWTs
IDENTITY_PUBLIC_KEY=file:/app/keys/identity_public.pem
# Gateway key pair — signs Gateway JWTs (public key optional, checked against the private key)
GATEWAY_PRIVATE_KEY=file:/app/keys/gateway_private.pem
GATEWAY_PUBLIC_KEY=file:/app/keys/gateway_public.pem
GATEWAY_JWT_EXPIRES_IN=5m

# Service JWT public keys — one per registered backend service (all required)
IDENTITY_SERVICE_PUBLIC_KEY=file:/app/keys/services/identity-access-service_public.pem
RESIDENT_SERVICE_PUBLIC_KEY=file:/app/keys/services/resident-management-service_public.pem
PROPERTY_SERVICE_PUBLIC_KEY=file:/app/keys/services/property-unit-service_public.pem
LEASE_SERVICE_PUBLIC_KEY=file:/app/keys/services/lease-occupancy-service_public.pem
BILLING_SERVICE_PUBLIC_KEY=file:/app/keys/services/billing-payment-service_public.pem
UTILITY_SERVICE_PUBLIC_KEY=file:/app/keys/services/utility-charge-service_public.pem
OPERATIONS_SERVICE_PUBLIC_KEY=file:/app/keys/services/operations-service_public.pem
COMMUNITY_SERVICE_PUBLIC_KEY=file:/app/keys/services/community-service_public.pem

# Health aggregation
DOWNSTREAM_HEALTH_TIMEOUT=2s
HEALTH_CACHE_TTL=10s
